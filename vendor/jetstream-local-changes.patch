+// r[verify jetstream.wireformat.prost]
+/// The length prefix is a `usize` per WF-USIZE: eight bytes on every target,
+/// and `byte_size` counts exactly those. It used to be the target's pointer
+/// width, so a wasm32 encoder and a 64-bit decoder disagreed about where the
+/// protobuf bytes started.
+#[test]
+fn test_prost_wireformat_length_prefix_is_eight_bytes() {
+    let message = TestMessage {
+        id: 0,
+        name: "/".to_string(),
+        data: vec![],
+    };
+    let len = message.encoded_len();
+    let wrapper = TestMessageWrapper::new(message);
+
+    let mut bytes = Vec::new();
+    wrapper.encode(&mut bytes).expect("Failed to encode");
+
+    assert_eq!(bytes[..8], (len as u64).to_le_bytes());
+    assert_eq!(bytes.len(), 8 + len);
+    assert_eq!(wrapper.byte_size() as usize, bytes.len());
+}

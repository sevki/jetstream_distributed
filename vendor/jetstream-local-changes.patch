+jetstream_wasm = { version = "16.3.1", path = "components/jetstream_wasm" }
+
+# QUIC and the HTTP transport built on it are native-only: quinn reaches for
+# UDP sockets, which wasm32-unknown-unknown has no equivalent of. Declaring
+# them here rather than in [dependencies] keeps that a property of the
+# *target*, not of the feature -- so enabling `quic` (or `http`, which
+# implies it) in a workspace that also builds for wasm32 doesn't drag quinn
+# into the wasm build.
+#
+# That distinction is invisible to cargo, which resolves features per build
+# anyway, but it matters to anything that resolves a single feature set for
+# a whole workspace across several target triples -- Bazel's crate_universe
+# being the case in hand. A target-gated dependency becomes a `select()`
+# there, where a feature-gated one is unconditional.
+[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
+jetstream_quic = { version = "16.3.1", path = "components/jetstream_quic", optional = true }
+jetstream_http = { version = "16.3.1", path = "components/jetstream_http", optional = true }
 
